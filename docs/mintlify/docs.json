{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GLua Language Server",
  "colors": {
    "primary": "#4A9EFF",
    "light": "#6DB8FF",
    "dark": "#2B7DD9"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "getting-started/installation",
              "getting-started/workspace-setup",
              "getting-started/common-fixes"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/overview",
              "configuration/gmod",
              "configuration/diagnostics",
              "configuration/formatting",
              "configuration/workspace",
              "configuration/completion",
              "configuration/hints-and-hover",
              "configuration/runtime",
              "configuration/annotations-management"
            ]
          },
          {
            "group": "Debugger",
            "pages": [
              "debugger/setup",
              "debugger/usage",
              "debugger/ai-agents"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "tools/glua-check"
            ]
          }
        ]
      },
      {
        "tab": "Annotations",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "annotations/index"
            ]
          },
          {
            "group": "Type system",
            "pages": [
              "annotations/class",
              "annotations/type",
              "annotations/field",
              "annotations/alias",
              "annotations/enum",
              "annotations/generic",
              "annotations/operator"
            ]
          },
          {
            "group": "Functions",
            "pages": [
              "annotations/param",
              "annotations/return",
              "annotations/outparam",
              "annotations/adds-field",
              "annotations/overload",
              "annotations/async",
              "annotations/nodiscard"
            ]
          },
          {
            "group": "Garry's Mod Lua",
            "pages": [
              "annotations/realm",
              "annotations/hook",
              "annotations/fileparam",
              "annotations/accessorfunc",
              "annotations/call-arg",
              "annotations/valid-guard",
              "annotations/self-guard",
              "annotations/self-call-valid"
            ]
          },
          {
            "group": "Utilities",
            "pages": [
              "annotations/diagnostic",
              "annotations/cast",
              "annotations/deprecated",
              "annotations/meta",
              "annotations/module",
              "annotations/source",
              "annotations/version",
              "annotations/see"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub - VS Code",
          "href": "https://github.com/Pollux12/vscode-gmod-glua-ls",
          "icon": "github"
        },
        {
          "anchor": "GitHub - LS",
          "href": "https://github.com/Pollux12/gmod-glua-ls",
          "icon": "github"
        },
        {
          "anchor": "Issues",
          "href": "https://github.com/Pollux12/gmod-glua-ls/issues",
          "icon": "circle-exclamation"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/Pollux12/vscode-gmod-glua-ls"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install Extension",
      "href": "https://marketplace.visualstudio.com/items?itemName=Pollux.gmod-glua-ls"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "redirects": [
    {
      "source": "/annotations/guard-metadata",
      "destination": "/annotations/valid-guard"
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/Pollux12/vscode-gmod-glua-ls"
    }
  }
}
